# Non-secret local configuration for the CreditOps Bedrock demo.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
CREDITOPS_BORROWER_ID=atlas-manufacturing

# Non-secret identity context for the local read-only MCP server.
CREDITOPS_MCP_ACTOR_ID=portfolio-demo-banker
CREDITOPS_MCP_ROLE=BANKER

# Local-only human approval adapter. Production should use authenticated identity.
CREDITOPS_DEMO_REVIEWER_ID=local-demo-credit-officer
CREDITOPS_DECISION_LOG_PATH=.creditops-data/review-decisions.jsonl
CREDITOPS_ALLOW_DEMO_APPROVALS=false

# Prefer temporary credentials from AWS IAM Identity Center or an AWS profile.
# Never commit access keys or session tokens to this file.
